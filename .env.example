# Database (Neon)
# Use the pooled connection string (host ends in "-pooler") for the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Used only by `prisma migrate deploy` (build time).
# Use Neon's direct, non-pooled connection string (same host without "-pooler").
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Assina o cookie de sessão. Gere com: openssl rand -base64 32
# Sem isto a aplicação falha de propósito — assinar sessão com segredo vazio
# deixaria qualquer um forjar um login.
AUTH_SECRET="generate-a-random-secret"

# URL pública da aplicação. Usada para montar o link do QR code de cada evento
# e o link de convite de delegado.
APP_URL="http://localhost:3000"

# Cron job auth (Vercel Cron sends this as Authorization: Bearer <value>)
CRON_SECRET="generate-a-random-secret"

# Conta de master admin criada pelo seed.
# O seed é idempotente e nunca sobrescreve a senha de um usuário existente.
SEED_ADMIN_EMAIL="voce@exemplo.com"
SEED_ADMIN_NAME="Seu Nome"
SEED_ADMIN_PASSWORD="uma-senha-forte"
