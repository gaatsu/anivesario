datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Credenciais moram aqui: passwordHash guarda um hash scrypt (ver lib/auth.ts).
// Contas nascem só pelo seed ou pelo resgate de um convite — não há cadastro aberto.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(ADMIN)

  events    Event[]
  delegates Delegate[] @relation("MasterAdmin")
  delegated Delegate[] @relation("DelegateUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  MASTER_ADMIN
  ADMIN
}

model Event {
  id           String   @id @default(cuid())
  title        String
  description  String?
  type         String   @default("birthday")
  eventDate    DateTime

  creatorId    String
  creator      User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // Dois links distintos: shareLink é o que circula entre quem deixa recado;
  // revealLink é o que vai para o homenageado — ele abre o mural em modo
  // somente-leitura e com as animações tocando.
  shareLink    String   @unique @default(cuid())
  revealLink   String   @unique @default(cuid())
  status       EventStatus @default(ACTIVE)

  animations   String[] @default([])

  // URLs públicas no Vercel Blob. Só as URLs moram aqui; os binários ficam lá.
  // Como o evento se apaga sozinho em 12h, quem apaga o evento também precisa
  // apagar os blobs — ver purgarEventos em lib/eventLifecycle.ts.
  photos       String[] @default([])

  postits      Postit[]
  qrCode       QRCode?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([creatorId])
  @@index([shareLink])
}

enum EventStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model Postit {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name      String
  message   String

  color     String   @default("#FEF08A")
  icon      String?

  positionX Float    @default(0)
  positionY Float    @default(0)

  createdAt DateTime @default(now())

  @@index([eventId])
}

// Convite por link: o master admin gera um token aleatório e envia a URL. Quem
// abrir define a própria senha. Uso único — um token ACCEPTED nunca mais vale.
model Delegate {
  id        String   @id @default(cuid())
  token     String   @unique
  label     String?

  creatorId String
  creator   User     @relation("MasterAdmin", fields: [creatorId], references: [id], onDelete: Cascade)

  delegateId   String? @unique
  delegateUser User?   @relation("DelegateUser", fields: [delegateId], references: [id], onDelete: SetNull)

  status    DelegateStatus @default(PENDING)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
}

enum DelegateStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model QRCode {
  id        String   @id @default(cuid())
  eventId   String   @unique
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  url       String

  generatedAt DateTime @default(now())
}

